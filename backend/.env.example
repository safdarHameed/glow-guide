ENVIRONMENT=development

# Postgres (async driver)
DATABASE_URL=postgresql+asyncpg://glowguide:LOCAL_PASSWORD@127.0.0.1:55432/glowguide
TEST_DATABASE_URL=postgresql+asyncpg://glowguide_test:TEST_PASSWORD@127.0.0.1:55432/glowguide_test

# Frontend origin: used for CORS and for links in emails (password reset)
APP_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3001

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30

# Google sign-in: OAuth client of type "Web application", with the frontend URL as an
# authorized JavaScript origin. Leave empty to disable the Google button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Server-side integrations. Unconfigured services return explicit 503 errors; no sample results are substituted.
# GEMINI_API_KEY powers the shared free AI tier; users can also connect their own OpenAI, Gemini, Grok or
# OpenAI-compatible model in Settings.
YOUCAM_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
SCAN_TIMEOUT_SECONDS=60

# Free-tier AI requests per user per day.
FREE_AI_DAILY_LIMIT=30
# Encrypts API keys users connect. Optional; derived from JWT_SECRET when empty. Changing it means users reconnect.
AI_KEYS_SECRET=

# Outgoing email. Leave SMTP_HOST empty to print emails to the server log instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=GlowGuide <no-reply@glowguide.app>
